# MemorAid backend configuration
# Copy to .env and fill in real values.

# Flask
SECRET_KEY=change-me
FLASK_DEBUG=1
PORT=5000

# Database — the document (section 3.5.1) mandates PostgreSQL.
# If PostgreSQL is not reachable the app falls back to a local SQLite file
# with a loud warning so the prototype stays demoable.
DATABASE_URL=postgresql+psycopg2://memoraid:memoraid@localhost:5432/memoraid

# JWT
JWT_SECRET_KEY=change-me-too
JWT_ACCESS_TOKEN_EXPIRES_DAYS=7

# Google Gemini API. Paste your key after the "=" (get one from
# https://aistudio.google.com/apikey). Leave empty to run entirely on the
# deterministic fallback generators (questions are then flagged
# generatedbyai=false).
GEMINI_API_KEY=
# Tiered models: the fast tier handles background passes (fact extraction,
# question generation) and the deep tier powers optional deep reflection.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_DEEP=gemini-3.8-flash

# Offline personalisation demo. With no API key set and AI_MOCK_MODE=1 the chat
# companion still streams a reply assembled from the real context pack
# (facts + retrieved memories + past turns), so the pipeline can be tested
# end to end without network access. A real API key always takes precedence.
AI_MOCK_MODE=0
MOCK_STREAM_DELAY=0.02

# Semantic retrieval. 'local' runs an offline hashing embedder (no key, no
# network); 'voyage' or 'openai' switch to a hosted embedding model.
EMBEDDING_PROVIDER=local
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=512

# How much context each reply is allowed to pull in.
RETRIEVAL_MEMORY_LIMIT=6
RETRIEVAL_FACT_LIMIT=8
RETRIEVAL_CHAT_LIMIT=4
CHAT_HISTORY_TURNS=8

# Email — 'console' prints family alerts to the server log (dev/demo),
# 'smtp' sends real mail.
EMAIL_BACKEND=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=memoraid@example.com

# Scheduler
ENABLE_SCHEDULER=1

# Notifications. All notification text is predefined in
# backend/services/notifications.py — no AI service is ever called to create,
# schedule or send one, so notifications keep working when Gemini is offline.
NOTIFICATION_DUE_REVIEW=1
NOTIFICATION_INACTIVITY=1
DEFAULT_TIMEZONE=UTC
NOTIFICATION_CHECK_INTERVAL_MINUTES=5

# Web Push (VAPID). Leave empty to run with in-app notifications only; the
# backend detects this and the frontend hides the push control. To enable
# browser push, generate a key pair (e.g. with the `py-vapid`/`webpush`
# tooling or `npx web-push generate-vapid-keys`) and paste both values, then
# install the optional dependency: pip install pywebpush
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:memoraid@example.com

# Pattern Confidence Module
PATTERN_DECAY_RATE=0.9
PATTERN_CONTEXT_THRESHOLD=0.6
PATTERN_STALE_FLOOR=0.3

# Family connection mode
INACTIVITY_THRESHOLD_HOURS=24
